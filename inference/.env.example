# 주의: docker compose 의 env_file 은 값이 비어 있는 줄의 뒤 주석을 값으로 읽는다. 주석은 반드시 별도 줄에.

# cuda | cpu (GPU 없는 PC 는 cpu, compose 의 deploy 블록 주석 처리)
DEVICE=cuda
MODEL_DIR=./weights
# BE 의 INFERENCE_TOKEN 과 동일하게. 비우면 인증 생략(로컬)
INFERENCE_TOKEN=
MAX_IMAGE_BYTES=1048576
# 224 로 줄이면 빠름. 정확도 비교 후 결정
GAZE_INPUT_SIZE=448
GAZE_CROP_MARGIN=0.20
# STT: faster-whisper 모델 크기 (tiny|base|small|medium). 팀 결정: small
STT_MODEL=small
STT_LANGUAGE=ko

# 감정 모델 v2 (AI 팀 납품). 되돌리기: EMOTION_WEIGHTS=emotionnet_v1.pth, EMOTION_LABELS=기쁨,당황,분노,불안,상처,슬픔,중립, EMOTION_BIAS=, EMOTION_TAU=0, EMOTION_RESIZE=area
EMOTION_WEIGHTS=emotionnet_v2.pth
EMOTION_LABELS=기쁨,당황,불안,중립
EMOTION_BIAS=0.0,1.4,0.0,1.9
EMOTION_TAU=0.98
EMOTION_RESIZE=linear
