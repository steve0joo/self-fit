# 복사해서 .env 로 만들고 값을 채운다. .env 는 git 에 올라가지 않는다.
APP_ENV=development
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
# ES256(JWKS) 프로젝트는 비워 둔다. 구형 HS256 프로젝트만 대시보드 JWT Secret 입력
SUPABASE_JWT_SECRET=
# JSON 배열 문자열. 같은 네트워크 팀원 FE 주소를 추가 (예: "http://192.168.0.12:3000")
CORS_ORIGINS=["http://localhost:3000"]

# DB: 비우면 로컬 SQLite(dev.db). Supabase 는 Settings → Database → Connection string (Transaction pooler, 6543)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 추론 백엔드: mock(Phase 1) | http(Phase 2)
INFERENCE_BACKEND=mock
INFERENCE_URL=http://localhost:9000
INFERENCE_TOKEN=
INFERENCE_TIMEOUT_MS=1000

# 판정 임계값 (기본값은 app/config.py). 필요할 때만 덮어씀
# GAZE_YAW_THRESHOLD_DEG=20
# GAZE_OFF_SECONDS=3
# EMOTION_NEGATIVE_SECONDS=5

# LLM 리포트 (OpenAI API). 키는 팀 채널로 받아 .env 에만 넣는다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# STT 사용 여부 (엔진은 추론 서버에 있음)
STT_ENABLED=true

# 녹화 저장 위치 (git 제외). 세션 삭제 시 함께 삭제
MEDIA_DIR=./media
